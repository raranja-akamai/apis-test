    "/user-admin/groups/move": {
      "x-akamai": {
        "path-info": "/user-admin/groups/move"
      },
      "post": {
        "operationId": "post-groups-move",
        "summary": "Move a group",
        "tags": [
          "Move groups"
        ],
        "description": "This operation moves a nested group under another group within the same parent hierarchy.\n",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "sourceGroupId": 12345,
                "destinationGroupId": 54321
              },
              "schema": {
                "type": "object",
                "description": "Describes the request body to move one group under another group.\n",
                "additionalProperties": false,
                "required": [
                  "sourceGroupId",
                  "destinationGroupId"
                ],
                "properties": {
                  "destinationGroupId": {
                    "type": "integer",
                    "description": "Identifies the group within account hierarchy where you want to move the `sourceGroupId`. It can't be a child or descendant of the current group.\n"
                  },
                  "sourceGroupId": {
                    "type": "integer",
                    "description": "Identifies the nested group you want to move to the `destinationGroupId`.\n"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Nested group successfully moved.\n"
          }
        }
      }
    },
    "/user-admin/groups/move/{sourceGroupId}/{destinationGroupId}/affected-users": {
      "x-akamai": {
        "path-info": "/user-admin/groups/move/{sourceGroupId}/{destinationGroupId}/affected-users"
      },
      "parameters": [
        {
          "name": "destinationGroupId",
          "in": "path",
          "description": "Unique identifier for a group you're putting the other group into. To get this value, run the [List groups](ref:get-groups) operation.\n",
          "required": true,
          "schema": {
            "type": "integer",
            "example": 54321
          }
        },
        {
          "name": "sourceGroupId",
          "in": "path",
          "description": "Unique identifier for a group you want to move. To get this value, run the [List groups](ref:get-groups) operation.\n",
          "required": true,
          "schema": {
            "type": "integer",
            "example": 32145
          }
        }
      ],
      "get": {
        "operationId": "get-move-affected-users",
        "summary": "List users affected by moving a group",
        "tags": [
          "Move groups"
        ],
        "description": "This operation lists users who are affected when you move a group. Users may lose or gain access to resources depending on the roles and permissions inherited from the new parent group. Users with a `userType` of `lostAccess` lose their access to the source group. If the `userType` is `gainAccess`, they gain access to the resources in the source group. Users who have inherited access to a group lose access to that group if it moves out of its hierarchy that gives them those access rights. If the group moves to another parent group to which they have access, they still have access to the group you move. Likewise, when you move a group to a new location, users who inherit their access rights from the new parent group gain access to the resources in the group you move.\n",
        "parameters": [
          {
            "name": "userType",
            "in": "query",
            "description": "Filters the list by users who have `lostAccess` or the reverse `gainAccess`.\n",
            "schema": {
              "type": "string",
              "example": "lostAccess",
              "enum": [
                "lostAccess",
                "gainAccess"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The response provides the affected users.\n",
            "content": {
              "application/json": {
                "example": [
                  {
                    "uiIdentityId": "A-B-12345",
                    "firstName": "John",
                    "lastName": "Smith",
                    "accountId": "A-CCT7890",
                    "email": "jsmith@example.com",
                    "uiUserName": "jsmith@example.com",
                    "lastLoginDate": "2017-08-03T21:15:27.000Z"
                  },
                  {
                    "uiIdentityId": "1-2A3BCD",
                    "firstName": "Jan",
                    "lastName": "Kowalski",
                    "accountId": "A-CCT1234",
                    "email": "jkowalski@example.com",
                    "uiUserName": "jkowalski@example.com",
                    "lastLoginDate": "2016-09-07T00:00:00.000Z"
                  }
                ],
                "schema": {
                  "type": "array",
                  "description": "Lists users affected when moving a group.\n",
                  "items": {
                    "type": "object",
                    "description": "Specifies the affected user.\n",
                    "additionalProperties": false,
                    "properties": {
                      "accountId": {
                        "type": "string",
                        "description": "A unique identifier for each account.\n"
                      },
                      "email": {
                        "type": "string",
                        "description": "The user's email address.\n",
                        "format": "email"
                      },
                      "firstName": {
                        "type": "string",
                        "description": "The user's first name.\n"
                      },
                      "lastLoginDate": {
                        "type": "string",
                        "description": "ISO 8601 timestamp indicating when the user last logged in.\n",
                        "format": "date-time"
                      },
                      "lastName": {
                        "type": "string",
                        "description": "The user's last name.\n"
                      },
                      "uiIdentityId": {
                        "type": "string",
                        "description": "A unique identifier for a user.\n"
                      },
                      "uiUserName": {
                        "type": "string",
                        "description": "The full name for the user, as it appears in interfaces.\n"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
