        "path-info": "/user-admin/groups"
      },
      "get": {
        "operationId": "get-groups",
        "summary": "List groups",
        "tags": [
          "Groups"
        ],
        "description": "This operation lists all groups the administrator can manage for the current account and contract type or other managed accounts using the `accountSwitchKey` parameter. The account and contract type are determined by the access tokens in your API client.\n",
        "parameters": [
          {
            "name": "actions",
            "in": "query",
            "description": "Includes information about actions such as `edit` or `delete` that you can take for the object, `false` by default. Don't confuse this with the `action` parameter, which applies to the [Set two-factor authentication](ref:put-user-profile-tfa) operation.\n",
            "schema": {
              "type": "boolean",
              "example": true,
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The response provides the groups.\n",
            "content": {
              "application/json": {
                "example": [
                  {
                    "groupId": 12345,
                    "groupName": "Main Street Corporation",
                    "createdDate": "2012-04-28T00:00:00.000Z",
                    "createdBy": "szhang",
                    "modifiedDate": "2012-04-28T00:00:00.000Z",
                    "modifiedBy": "hgildong",
                    "actions": {
                      "edit": true,
                      "delete": false
                    },
                    "subGroups": [
                      {
                        "groupId": 12345,
                        "groupName": "Internet Company",
                        "createdDate": "2013-10-29T19:05:52.000Z",
                        "createdBy": "szhang",
                        "modifiedDate": "2017-07-25T22:30:20.000Z",
                        "modifiedBy": "mrossi",
                        "parentGroupId": 12345,
                        "actions": {
                          "edit": true,
                          "delete": false
                        },
                        "subGroups": [
                          {
                            "groupId": 54321,
                            "groupName": "Digital Company",
                            "createdDate": "2017-07-25T22:30:47.000Z",
                            "createdBy": "jkowalski",
                            "modifiedDate": "2017-07-25T22:30:47.000Z",
                            "modifiedBy": "jkowalski",
                            "parentGroupId": 11111,
                            "subGroups": [],
                            "actions": {
                              "edit": true,
                              "delete": false
                            }
                          }
                        ]
                      }
                    ]
                  }
                ],
                "schema": {
                  "type": "array",
                  "description": "Encapsulates information about a group.\n",
                  "items": {
                    "type": "object",
                    "description": "Encapsulates information about a group.\n",
                    "additionalProperties": false,
                    "properties": {
                      "actions": {
                        "type": "object",
                        "description": "Encapsulates permissions available to the user for this group. This data is available when you specify the `actions` parameter of the same name, not to be confused with the `action` parameter, which applies to the [Set two-factor authentication](ref:put-user-profile-tfa) operation.\n",
                        "additionalProperties": false,
                        "properties": {
                          "delete": {
                            "type": "boolean",
                            "description": "Indicates whether the user can remove items from the group.\n"
                          },
                          "edit": {
                            "type": "boolean",
                            "description": "Indicates whether the user can modify items in the group.\n"
                          }
                        }
                      },
                      "createdBy": {
                        "type": "string",
                        "description": "The username of the person who created the group.\n"
                      },
                      "createdDate": {
                        "type": "string",
                        "description": "ISO 8601 timestamp indicating when the group was originally created.\n",
                        "format": "date-time"
                      },
                      "groupId": {
                        "type": "integer",
                        "description": "A unique identifier for each group.\n"
                      },
                      "groupName": {
                        "type": "string",
                        "description": "A group's name.\n"
                      },
                      "modifiedBy": {
                        "type": "string",
                        "description": "The username of the last person to edit the group.\n"
                      },
                      "modifiedDate": {
                        "type": "string",
                        "description": "ISO 8601 timestamp indicating when the group was last updated.\n",
                        "format": "date-time"
                      },
