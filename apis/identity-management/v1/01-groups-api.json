  ],
  "tags": [
    {
      "description": "Manage groups for your account. Groups are organizational containers\nfor the objects you use in Control Center.\n",
      "name": "Groups"
    },
    {
      "description": "Move nested groups within the same parent hierarchy.\n",
      "name": "Move groups"
    }
